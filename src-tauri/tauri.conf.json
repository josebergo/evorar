{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "evorar",
  "version": "0.3.2",
  "identifier": "cn.evorar.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Evorar 艾呀压",
        "width": 680,
        "height": 470,
        "minWidth": 560,
        "minHeight": 400,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "icon": ["icons/icon.ico", "icons/icon.icns", "icons/icon.png"],
    "fileAssociations": [
      { "ext": ["zip"], "name": "ZIP 压缩包", "role": "Viewer" },
      { "ext": ["7z"], "name": "7Z 压缩包", "role": "Viewer" },
      { "ext": ["rar"], "name": "RAR 压缩包", "role": "Viewer" },
      { "ext": ["tar", "tgz", "gz", "bz2", "tbz2", "xz", "txz"], "name": "TAR 系压缩包", "role": "Viewer" }
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
